{
  "name": "prompt-optimizer",
  "version": "2.1.6",
  "description": "A professional prompt optimization assistant that transforms simple instructions into production-ready prompts",
  "type": "skill",
  "entry": "SKILL.md",
  "author": "dreamor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamor/prompt-optimizer-skill.git"
  },
  "keywords": [
    "prompt",
    "prompt-engineering",
    "claude-code",
    "skill",
    "ai",
    "optimization"
  ],
  "categories": [
    "productivity",
    "development",
    "writing"
  ],
  "commands": {
    "optimize": {
      "description": "Optimize a user-provided prompt",
      "usage": "optimize [your prompt]"
    },
    "frameworks": {
      "description": "List all available prompt frameworks",
      "usage": "frameworks [--list|--detail]"
    },
    "test": {
      "description": "Run the automated test suite (framework integrity + CLI smoke tests + JSON validation)",
      "usage": "test"
    }
  },
  "hooks": {
    "onInstall": {
      "description": "Display welcome message after installation",
      "command": "cat WELCOME.md"
    }
  },
  "config": {
    "defaultVersion": "enhanced"
  },
  "compatibility": {
    "claude-code": ">=1.0.0"
  }
}
